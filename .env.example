# Required
OPENROUTER_API_KEY=sk-or-...

# Default model loaded in the UI (include :online for web search)
DEFAULT_MODEL=anthropic/claude-3.5-sonnet:online

# Comma-separated list shown in the model dropdown
AVAILABLE_MODELS=anthropic/claude-3.5-sonnet:online,openai/gpt-4o:online,google/gemini-2.0-flash-001:online,meta-llama/llama-3.3-70b-instruct:online

# Port (default 8000)
PORT=8000
